#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <1 2>;
            then-layer = <2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |RGB_TOG|  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | ALT  | GUI  | LOWER|  SPACE |  | ENTER | RAISE| BSPC  | GUI   |

            bindings = <
&kp ESC    &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                                 &kp N6  &kp N7    &kp N8      &kp N9   &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W   &kp E     &kp R     &kp T                                  &kp Y   &kp U     &kp I       &kp O    &kp P     &kp LEFT_BRACKET
&kp LCTRL  &kp A   &kp S   &kp D     &kp F     &kp G                                  &kp H   &kp J     &kp K       &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z   &kp X   &kp C     &kp V     &kp B   &kp C_MUTE    &rgb_ug RGB_TOG  &kp N   &kp M     &kp COMMA   &kp DOT  &kp FSLH  &kp K_MENU
                           &kp LALT  &kp LGUI  &mo 1   &kp SPACE     &kp RET          &to 2   &kp BSPC  &kp DELETE
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |EXTPWR |     |     |      |      |      |        |  |       |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp F1  &kp F2          &kp F3          &kp F4           &kp F5  &kp F6                    &kp F7           &kp F8           &kp F9           &kp F10  &kp F11            &kp F12
&trans  &trans          &kp UP_ARROW    &trans           &trans  &trans                    &kp PRINTSCREEN  &kp K_SCROLL_UP  &kp PAUSE_BREAK  &trans   &kp MINUS          &kp EQUAL
&trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans                    &trans           &kp UP_ARROW     &trans           &trans   &kp RIGHT_BRACKET  &kp BACKSLASH
&trans  &trans          &trans          &trans           &trans  &trans  &trans    &trans  &kp LEFT_ARROW   &kp DOWN_ARROW   &kp RIGHT_ARROW  &trans   &trans             &kp RIGHT_SHIFT
                                        &trans           &trans  &trans  &trans    &trans  &trans           &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        adjast_layer {
            bindings = <
&bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1                      &bt BT_SEL 2                      &bt BT_SEL 3                      &bt BT_SEL 4                    &kp LS(K_CALCULATOR)  &kp DELETE       &kp KP_DIVIDE    &kp KP_MULTIPLY  &kp KP_SUBTRACT  &trans
&ext_power EP_TOG  &rgb_ug RGB_TOG  &rgb_ug RGB_COLOR_HSB(126,47,35)  &rgb_ug RGB_COLOR_HSB(172,49,39)  &rgb_ug RGB_COLOR_HSB(25,100,50)  &trans                          &trans                &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &trans
&ext_power EP_ON   &rgb_ug RGB_ON   &rgb_ug RGB_HUI                   &rgb_ug RGB_SAI                   &rgb_ug RGB_BRI                   &trans                          &trans                &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp BACKSPACE    &kp KP_COMMA
&ext_power EP_OFF  &rgb_ug RGB_OFF  &rgb_ug RGB_HUD                   &rgb_ug RGB_SAD                   &rgb_ug RGB_BRD                   &trans        &trans    &trans  &trans                &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_ENTER     &trans
                                                                      &trans                            &trans                            &trans        &trans    &trans  &to 0                 &kp KP_NUMBER_0  &kp KP_DOT
            >;
        };
    };
};
